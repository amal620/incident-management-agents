# Copiez ce fichier vers .env puis remplissez-le. Ne publiez JAMAIS .env.

# --- LLM via OpenRouter (optionnel : sans clé, analyse heuristique de secours) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# --- Compte administrateur (créé au premier démarrage) ---
# Remplacez le mot de passe (minimum 10 caractères) avant de lancer l'application.
ADMIN_EMAIL=admin@fusionflow.local
ADMIN_PASSWORD=
SESSION_DAYS=7
# Mettre true derrière HTTPS (production)
COOKIE_SECURE=false
DATABASE_PATH=fusionflow.db

# --- Gouvernance / SemVer ---
# Version initiale (après le 1er démarrage, la version courante est lue dans la base)
AGENT_VERSION=1.0.0

# --- GitHub ---
# owner/repo : affiche le dernier run GitHub Actions. Token à permissions minimales (dépôt privé uniquement).
GITHUB_REPOSITORY=
GITHUB_TOKEN=

# --- Git depuis la Dashboard (désactivé par défaut) ---
GIT_SYNC_ENABLED=false
# true = créer automatiquement le tag Git vX.Y.Z quand l'admin crée une version (nécessite GIT_SYNC_ENABLED=true)
AUTO_TAG_ON_VERSION=false

# --- Coupe-circuit initial ---
KILL_SWITCH_ACTIVE=false
